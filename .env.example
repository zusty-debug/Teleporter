# ── Teleporter configuration ────────────────────────────────────────────
# Copy this file to .env for local runs, or set these as environment
# variables on your hosting platform.

# OPTIONAL but STRONGLY RECOMMENDED for public deployments:
# password that unlocks the web UI (sent as X-App-Token header).
# Without this, anyone who finds your URL can use your Telegram session!
APP_PASSWORD=

# Where the SQLite database lives. On Docker hosts, keep /data (it's a volume).
# DATA_DIR=/data
# DB_PATH=/data/teleporter.db

# Optional pre-fill for the login form (does NOT auto-login)
DEFAULT_API_ID=
DEFAULT_API_HASH=

# Default delay between copied messages (seconds). 1.0 is a safe default.
DEFAULT_DELAY=1.0

# Server binding (leave as-is for Docker/PaaS)
HOST=0.0.0.0
PORT=8000
